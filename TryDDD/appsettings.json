{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApiDocs": {
    "Cart": "http://localhost:5101/openapi/v1.json",
    "Catalog": "http://localhost:5102/openapi/v1.json",
    "Identity": "http://localhost:5103/openapi/v1.json",
    "Order": "http://localhost:5104/openapi/v1.json"
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "cart": {
        "ClusterId": "cluster-cart",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "catalog": {
        "ClusterId": "cluster-catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "identity": {
        "ClusterId": "cluster-identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "order": {
        "ClusterId": "cluster-order",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster-cart": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "cluster-catalog": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "cluster-identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "cluster-order": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104/"
          }
        }
      }
    }
  }
}
